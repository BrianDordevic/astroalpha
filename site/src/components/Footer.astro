// The Blade template hardcoded "© 2026"; deriving it stops the footer going
// stale at the next new year.
const year = new Date().getFullYear();
---

<footer class="content-info">
  <div class="info">
    <div class="location">
      <div class="logo-img">
        <a href="/"><img src="/assets/images/logo-desktop.svg" alt="Logo" /></a>
      </div>
      <div class="address">
        <p>875 N Michigan Ave.</p>
        <p>Chicago, IL 60611</p>
      </div>
      <img class="map" src="/assets/images/footer/map.webp" alt="Location of Alpha Efficiency" width="314" height="234" />
    </div>

    <div class="services">
      <h3>Our Services</h3>
      <ul>
        {services.map((s) => (
          <li>
            <a href={s.href}>
              <img src={`/assets/images/footer/icons/${s.icon}`} alt={s.alt} width="40" height="40" />
              <p>{s.label}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="quick-links">
      <h3>Quick Links</h3>
      <ul>
        {quickLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="line"></div>

  <div class="links">
    <div class="sections">
      <img src="/assets/images/footer/icons/vector.webp" alt="Dots" />
      {locations.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>

    <div class="copyright-links">
      <div class="copyright">
        <p>© {year} Alpha Efficiency <span>·</span> <br />All Rights Reserved</p>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-service">Terms of Service</a>
      </div>

      <div class="social">
        <ul>
          {social.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
                <svg width={s.size} height={s.size} viewBox={s.box} fill="none" xmlns="http://www.w3.org/2000/svg">
                  {s.d.map((d) => <path d={d} fill="#D3D3D3" />)}
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</footer>
