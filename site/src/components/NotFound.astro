<main>
  <Fragment set:html={graphic} />

  <section class="blog-section">
    <div class="container">
      <div class="top">
        <h2>Our Recent Blog Posts</h2>
        <hr />
      </div>

      <div class="bottom">
        {posts.map((p) => (
          <div class="post">
            <a class="image" href={p.path}>
              <img class="post-thumbnail" src={p.hero_image ?? `${IMG}/blog/post-image-holder-min.png`} alt="Post image" />
            </a>
            <div class="text">
              <div class="date">{fmt(p.published_at)}</div>
              <a href={p.path} class="title" set:html={p.title} />
              <hr />
              <div class="text-content" set:html={p.excerpt} />
              <a href={p.path} class="read-more">Read the Full Article</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</main>
