---
// Ported from alpha-efficiency-2024 404.blade.php. The "404" graphic is drawn
// as SVG shapes where each digit doubles as a link to a service page — copied
// verbatim, only the get_site_url() hrefs were made relative.
//
// The Blade version's "Recent Blog Posts" section runs a live wp_get_recent_posts()
// query with per-post thumbnail/attachment lookups; that has no D1 equivalent
// to port mechanically, so it's rebuilt here using listPosts() instead, with a
// static placeholder image for posts that have no hero_image (same fallback
// blog.astro already uses).
import type { Page } from '../lib/db';

interface Props {
  posts: Page[];
}
const { posts } = Astro.props;

const IMG = '/assets/images';

const fmt = (iso: string | null) => {
  if (!iso) return '';
  const d = new Date(iso);
  return `${String(d.getUTCDate()).padStart(2, '0')} - ${d.toLocaleString('en', { month: 'short', timeZone: 'UTC' })} - ${d.getUTCFullYear()}`;
};

