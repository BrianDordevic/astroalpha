---
// Ported from alpha-efficiency-2024 components/forms/project.blade.php, with
// the jQuery $.ajax submission in routes/common.js rewritten as fetch().
//
// The portal and form ids are HubSpot's *public* client-side identifiers —
// they are already served in the HTML of every page on the live site, so
// there is nothing secret here. The private HubSpot API key is not involved.
const HUBSPOT_PORTAL = '4773320';
const HUBSPOT_FORM_PROJECT = '7add9395-082e-4e41-883b-ee6d6535f682';

// Staging deliberately does NOT submit. A test fill on the staging site would
// otherwise create a real contact in the production CRM, and those are
// tedious to identify and remove after the fact.
const SITE = Astro.site?.origin ?? 'https://alphaefficiency.com';
const IS_PROD = SITE === 'https://alphaefficiency.com';

interface Props {
  title?: string;
}
const { title = 'Have A Project To Complete?' } = Astro.props;

const IMG = '/assets/images';

const projectTypes = ['Web Development', 'Web Design', 'SEO Campaigns', 'Digital Media', 'Strategic Consulting'];
const budgets = ['$3,000 - $7,000', '$7,000 - $10,000', '$10,000 - $30,000', '$30,000 - $100,000', '$100,000+'];
const steps = [
  { icon: 'complete.svg', alt: 'complete form icon', label: 'Complete Form' },
  { icon: 'discovery.svg', alt: 'Discovery icon', label: 'Discovery' },
  { icon: 'proposal.svg', alt: 'Get Proposal icon', label: 'Get a Proposal' },
];
---

<form
  id="project-form"
  data-project-form
  autocomplete="off"
  data-portal={HUBSPOT_PORTAL}
  data-form={HUBSPOT_FORM_PROJECT}
  data-live={IS_PROD ? 'true' : 'false'}
>
  <div class="background"></div>
  <div class="form-content-wrapper">
    <h3 set:html={title} />

    <div class="form-body">
      <div class="select-arrow">
        <label for="mySelect">Project Type</label>
        <select class="minimal" id="mySelect" required>
          <option value="" disabled selected>Project Type</option>
          {projectTypes.map((t) => <option value={t}>{t}</option>)}
        </select>
        <div class="arrow"></div>
      </div>

      <div class="select-arrow">
        <label for="mySelectBudget">Estimated Budget</label>
        <select class="minimal" id="mySelectBudget" required>
          <option value="" disabled selected>Estimated Budget</option>
          {budgets.map((b) => <option value={b}>{b}</option>)}
        </select>
        <div class="arrow"></div>
      </div>

      <input type="email" id="client-email-addr" placeholder="Your Email" required />
      <input type="text" id="client-name" placeholder="Your Name" required />
      <input type="text" id="business-name" placeholder="Website Address" />
      <input type="tel" id="client-phone-num" placeholder="Your Phone Number" required />
    </div>

    <div class="sms-consent">
      <label class="sms-consent-label">
        <input type="checkbox" required />
        By submitting this form, you agree to receive SMS communications from
        <strong>Alpha Efficiency</strong> regarding your inquiry. Message and data rates may apply.
        Reply STOP to opt out at any time.
      </label>
    </div>

    <button type="submit" class="submit-btn">Request Your Proposal</button>

    <p class="form-status" role="status" aria-live="polite" hidden></p>
  </div>

  <div class="aditional-buttons">
    <div class="buttons-holder">
      {steps.map((s) => (
        <article class="button-additional">
          <div class="icon-btn-form">
            <img src={`${IMG}/forms/project/${s.icon}`} alt={s.alt} />
          </div>
          {s.label}
        </article>
      ))}
    </div>
  </div>
</form>

<script>
  // Bound per form, not by id: the location template renders this component
  // twice on one page (subheader and footer), so both forms carry
  // id="project-form" and getElementById would only ever wire up the first —
  // leaving the second silently dead. Fields are read within each form for the
  // same reason.
  document.querySelectorAll<HTMLFormElement>('form[data-project-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('.form-status');
    const button = form.querySelector<HTMLButtonElement>('.submit-btn');
    const val = (id: string) =>
      (form.querySelector(`#${id}`) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

    const say = (msg: string) => {
      if (!status) return;
      status.textContent = msg;
      status.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button) button.disabled = true;

      // Field names must match the HubSpot form's internal property names —
      // the v3 submissions API rejects the whole payload on an unknown name.
      const payload = {
        fields: [
          { name: 'email', value: val('client-email-addr') },
          { name: 'firstname', value: val('client-name') },
          { name: 'project_name', value: val('business-name') },
          { name: 'project_type', value: val('mySelect') },
          { name: 'phone', value: val('client-phone-num') },
          { name: 'estimated_budget', value: val('mySelectBudget') },
        ],
        context: { pageUri: window.location.toString(), pageName: 'Alpha Efficiency' },
      };

      if (form.dataset.live !== 'true') {
        say('Staging: form validated but not submitted, so no test lead reaches HubSpot.');
        if (button) button.disabled = false;
        return;
      }

      try {
        const res = await fetch(
          `https://api.hsforms.com/submissions/v3/integration/submit/${form.dataset.portal}/${form.dataset.form}`,
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }
        );
        if (!res.ok) throw new Error(`HubSpot returned ${res.status}`);
        form.reset();
        window.location.assign('/thank-you-page');
      } catch (err) {
        say('Something went wrong sending your request. Please call us on (312) 300-6746.');
        if (button) button.disabled = false;
      }
    });
  });
</script>
