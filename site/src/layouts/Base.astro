---
// Every SEO-critical head tag is centralised here. The staging guard matters:
// without it, dev.alphaefficiency.com self-canonicalises and competes with
// production for the same 1,269 URLs.
// Read from Astro.site (fed by SITE_URL in astro.config.mjs at build time)
// rather than import.meta.env, which does not expose unprefixed vars at
// runtime. If that were undefined the check would silently fall back to
// production and ship an *indexable* staging site.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Corrections to layout bugs in the compiled theme stylesheet. Kept out of the
// generated page files so regenerating a page cannot silently drop them.
import '../styles/theme-fixes.css';

const SITE = Astro.site?.origin ?? 'https://alphaefficiency.com';
const IS_PROD = SITE === 'https://alphaefficiency.com';

interface Props {
  title: string;
  description?: string | null;
  canonical?: string | null;
  path: string;
  image?: string | null;
  noindex?: boolean;
  publishedAt?: string | null;
  updatedAt?: string | null;
  type?: 'website' | 'article';
  /**
   * Ported marketing templates draw their own hero *underneath* the fixed
   * header and manage their own width. They opt out of the generic content
   * offset; D1-backed pages keep it.
   */
  fullBleed?: boolean;
  /**
   * WordPress body_class() output for this template.
   *
   * This is not cosmetic. Every page stylesheet in the Sage theme is scoped
   * under its body class — the whole home design lives inside
   * `.page-template-template-home { … }`. Omit it and the section markup
   * renders completely unstyled, which looks like broken CSS rather than a
   * missing class. Each ported template must pass its own.
   */
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  path,
  image,
  noindex = false,
  publishedAt,
  updatedAt,
  type = 'website',
  fullBleed = false,
  bodyClass = '',
} = Astro.props;

// Canonicals always point at production, even when served from staging, so a
// crawler that reaches the dev host is told where the real page lives.
const canonicalUrl = canonical ?? `https://alphaefficiency.com${path === '/' ? '' : path}`;
const robots = !IS_PROD || noindex ? 'noindex, nofollow' : 'index, follow';
---

<!--
  Structure mirrors alpha-efficiency-2024 layouts/app.blade.php: banner /
  .wrap > .content > .main / content-info. The compiled Sage stylesheet targets
  these exact class names, so the nesting is load-bearing, not decorative.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PMBVTDM');
    </script>
    <!-- End Google Tag Manager -->
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Alpha Efficiency.™" />
    {image && <meta property="og:image" content={image} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@alphaefficiency" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
    />
    <!-- Compiled from the Sage theme by scripts/build-theme.mjs. -->
    <link rel="stylesheet" href="/assets/styles/main.css" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />

    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}
    {type === 'article' && updatedAt && (
      <meta property="article:modified_time" content={updatedAt} />
    )}
  </head>
  <body class={bodyClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PMBVTDM"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    {/*
      Pinned to the bottom, not the top. In normal flow this banner pushed the
      whole document down, and because the theme's header is `position: fixed`
      with `top: auto`, the header parked at its static offset — leaving a
      32.5px gap above it that only appeared once you scrolled past the banner.
      Taking the banner out of flow entirely means staging chrome cannot alter
      the layout it is supposed to be previewing.
    */}
    {!IS_PROD && (
      <div style="position:fixed;left:0;right:0;bottom:0;background:#b91c1c;color:#fff;padding:.4rem 1rem;font:600 13px system-ui;text-align:center;z-index:99999;pointer-events:none">
        STAGING — noindex. Content mirrors production as of the last D1 seed.
      </div>
    )}

    <Header path={path} />

    <div class={`wrap${fullBleed ? '' : ' ae-content-page'}`} role="document">
      <div class="content">
        <main class="main">
          <slot />
        </main>
      </div>
    </div>

    <style is:global>
      /* .banner is position:fixed (70px tall) in the Sage stylesheet. The
         original theme offset it per-template — the hero on marketing pages
         deliberately sits *under* the header, while text templates push down.
         Generic content routes get the offset here; hand-ported templates that
         want a full-bleed hero simply omit .ae-content-page. */
      .wrap.ae-content-page {
        padding-top: 90px;
      }
      .wrap.ae-content-page .main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 20px 60px;
      }
      .wrap.ae-content-page .main img {
        max-width: 100%;
        height: auto;
      }
    </style>

    <Footer />
  </body>
</html>
