---
import Base from '../layouts/Base.astro';
import { getPage, getRedirect, listPosts, listPostsPaged } from '../lib/db';
import { bodyClassFor } from '../lib/body-class';
import LocationSingle from '../components/LocationSingle.astro';
import NotFound from '../components/NotFound.astro';
import SinglePost from '../components/SinglePost.astro';

// Server-rendered from D1 rather than prerendered. With 1,269 pages a static
// build would need a full rebuild for every agent edit; this way a rewrite is
// a single UPDATE and is live immediately.
export const prerender = false;

const path = '/' + (Astro.params.slug ?? '');
const clean = path.replace(/\/+$/, '') || '/';

// Trailing-slash parity with the old WordPress site: /slug/ 301s to /slug.
if (path !== clean) {
  return Astro.redirect(clean, 301);
}

const redirect = await getRedirect(Astro.locals, clean);
if (redirect) {
  return Astro.redirect(redirect.to_path, redirect.code as 301 | 302);
}

const page = await getPage(Astro.locals, clean);

// Ported from alpha-efficiency-2024 404.blade.php. Rendered here rather than
// as its own src/pages/404.astro because this catch-all matches every path —
// a sibling 404.astro would never be reached.
let recentPosts: Awaited<ReturnType<typeof listPosts>> = [];
if (!page) {
  Astro.response.status = 404;
  recentPosts = await listPosts(Astro.locals, 6);
}

// The 40 Blade-only pages carry no body: their markup still lives in the Sage
// theme and has not been ported yet. Render an explicit placeholder rather
// than a convincing-looking empty page.
const needsPort = page ? page.track === 'template' && !page.body_html : false;

// The 402 location pages run on their own theme template, which supplies the
// header, form, sidebar and CTA sections around the stored copy. Without it a
// third of the site renders as bare paragraphs.
const isLocation = page ? page.track === 'location' : false;

// Reproduce WordPress's body_class(); the theme's page stylesheets are all
// scoped under it. See src/lib/body-class.ts. The 404 template's styles are
// scoped under .error404, same rule.
const bodyClass = page
  ? bodyClassFor({ type: page.type, slug: page.slug, wp_template: page.wp_template })
  : 'error404';

// Pages on the theme's default template (page.blade.php) render the content
// inside .content-holder and emit no heading at all — that template's
// @include('partials.page-header') is commented out. Rendering our own <h1>
// here gave /start-here two of them, since its copy already opens with one.
const isDefaultPage = page ? page.type === 'page' && !page.wp_template : false;

// Blog posts use partials/content-single-in-use.blade.php — a full layout
// (author sidebar, cross-sell cards, related posts, a second lead form)
// around the body, not just the article text. Rendering only the body here
// was the gap: real content, but with none of the surrounding page.
const isPost = page?.type === 'post';
let relatedPosts: Awaited<ReturnType<typeof listPosts>> = [];
if (isPost) {
  const categoryId = JSON.parse((page as any).categories ?? '[]')[0];
  const { posts } = await listPostsPaged(Astro.locals, { categoryId, perPage: 4 });
  relatedPosts = posts.filter((p) => p.path !== page!.path).slice(0, 3);
}
---

<Base
  title={page ? (page.meta_title ?? page.title) : 'Page Not Found — Alpha Efficiency'}
  description={page ? page.meta_description : 'Sorry, we couldn’t find the page you are looking for.'}
  canonical={page?.canonical}
  path={page ? page.path : clean}
  image={page?.hero_image}
  noindex={page ? page.robots_index === 0 : true}
  publishedAt={page?.published_at}
  updatedAt={page?.updated_at}
  type={page?.type === 'post' ? 'article' : 'website'}
  bodyClass={bodyClass}
  fullBleed={isLocation || isPost || !page}
>
  {!page ? (
    <NotFound posts={recentPosts} />
  ) : isLocation ? (
    <LocationSingle page={page} />
  ) : isPost && !needsPort ? (
    <SinglePost page={page} relatedPosts={relatedPosts} />
  ) : isDefaultPage && !needsPort ? (
    <div class="content-holder">
      <article set:html={page.body_html} />
    </div>
  ) : (
    <Fragment>
      <h1 set:html={page.title} />

      {needsPort ? (
        <div style="border:2px dashed #b91c1c;padding:1rem;margin:1rem 0">
          <strong>Not yet ported.</strong>
          <p>
            This page is rendered by <code>{page.wp_template}</code> in the Sage theme,
            so it has no content in the database. It needs porting to an Astro component.
          </p>
        </div>
      ) : (
        <article set:html={page.body_html} />
      )}
    </Fragment>
  )}
</Base>
