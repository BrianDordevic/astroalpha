---
import Base from '../layouts/Base.astro';

// Ported from alpha-efficiency-2024 template-support.blade.php ->
// partials.support.{form-section,hero-support} + components.forms.support.
//
// Unlike the project form, support uses HubSpot's own embedded widget
// (hbspt.forms.create) rather than a hand-built form posting to the API. The
// embed is loaded on production only — a test submission from staging would
// open a real support ticket.
const SITE = Astro.site?.origin ?? 'https://alphaefficiency.com';
const IS_PROD = SITE === 'https://alphaefficiency.com';
---

