            <path d="M73.2849 46.3152C70.5506 46.9748 67.7587 47.3724 64.9477 47.5025C64.9915 47.3431 65.0151 47.1789 65.0181 47.0137V2.11582C65.0181 1.58659 64.8062 1.07904 64.429 0.704818C64.0518 0.330597 63.5402 0.120361 63.0067 0.120361C62.4733 0.120361 61.9617 0.330597 61.5845 0.704818C61.2072 1.07904 60.9953 1.58659 60.9953 2.11582V47.0137C60.999 47.1854 61.0226 47.3561 61.0657 47.5225C58.5328 47.4197 56.013 47.106 53.5331 46.5846C53.6446 46.326 53.7027 46.0478 53.704 45.7665V20.1348C53.704 19.6056 53.4921 19.098 53.1149 18.7238C52.7377 18.3496 52.2261 18.1394 51.6926 18.1394C51.1592 18.1394 50.6476 18.3496 50.2704 18.7238C49.8932 19.098 49.6813 19.6056 49.6813 20.1348V45.5769C47.5321 44.9203 45.4374 44.0997 43.4158 43.1225V45.3175C49.4884 48.1112 56.1018 49.5582 62.7955 49.5579C66.489 49.5579 70.1693 49.1191 73.7576 48.2508L73.2849 46.3152Z" fill="#FFB000"></path>
