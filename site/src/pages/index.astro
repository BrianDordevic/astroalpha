<script>
  // The theme drove these with Bootstrap 4 + jQuery. Reimplemented in vanilla
  // JS so the homepage does not need jQuery, Popper and bootstrap.js (~120KB)
  // for two interactions.

  // Testimonial carousel — mirrors .carousel-fade's active-item swap.
  const carousel = document.getElementById('fadeCarousel');
  if (carousel) {
    const items = [...carousel.querySelectorAll<HTMLElement>('.carousel-item')];
    let current = 0;
    const show = (next: number) => {
      items[current]?.classList.remove('active');
      current = (next + items.length) % items.length;
      items[current]?.classList.add('active');
    };
    carousel.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-slide]');
      if (!btn) return;
      show(current + (btn.dataset.slide === 'next' ? 1 : -1));
    });
  }

  // Services carousel. The theme shipped these arrows as decoration — they had
  // no behaviour at all, so the cards that spilled past the container were
  // simply unreachable.
  const track = document.querySelector<HTMLElement>('[data-services-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-services-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-services-next]');

  if (track && prev && next) {
    const step = () => {
      const card = track.querySelector<HTMLElement>('.service-card');
      if (!card) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).gap) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    const sync = () => {
      // 2px tolerance: fractional scroll offsets never land exactly on the end.
      const atStart = track.scrollLeft <= 2;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
      prev.toggleAttribute('hidden', atStart);
      next.toggleAttribute('hidden', atEnd);
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }

  // FAQ accordion.
  //
  // The class here has to be `is-active`: the theme reveals answers with
  // `.faq.is-active .answer { display: flex }` and they are `display: none`
  // otherwise. Toggling any other name leaves every answer hidden with no
  // error — the questions look right and simply never open.
  document.querySelectorAll<HTMLButtonElement>('.toggle-answer-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const faq = btn.closest('.faq');
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      faq?.classList.toggle('is-active', !open);
    });
  });

  // Click-to-load YouTube: keeps the thumbnail until the user opts in, so the
  // homepage never ships a third-party iframe on first paint.
  document.querySelectorAll<HTMLElement>('.youtube-lazy-load').forEach((box) => {
    box.addEventListener('click', () => {
      const id = box.dataset.embed;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.width = '100%';
      frame.height = '100%';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.title = 'YouTube video player';
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      box.replaceChildren(frame);
    });
  });

  const promoButton = document.querySelector<HTMLImageElement>('.buttonPlay.video-image');
  if (promoButton) {
    promoButton.addEventListener('click', () => {
      const container = promoButton.closest('.video-container');
      if (!container) return;
      const iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube.com/embed/REgdFeNIXc4?autoplay=1&rel=0';
      iframe.frameBorder = '0';
      iframe.allow = 'autoplay; accelerometer; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = 'Alpha Efficiency Promo Video';
      iframe.width = '100%';
      iframe.height = '100%';
      container.replaceChildren(iframe);
    });
  }
</script>
