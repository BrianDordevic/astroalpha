---
import Base from '../layouts/Base.astro';
import ProjectForm from '../components/ProjectForm.astro';

// Ported from alpha-efficiency-2024 template-home.blade.php and its
// partials/home/* includes. Section wrappers and class names match the
// compiled Sage stylesheet exactly (.home-one, .second, .third, ...).
//
// Prerendered rather than SSR: the homepage is hand-authored, not D1 content,
// so there is nothing to look up per request. Static output also takes
// precedence over the [...slug] catch-all for "/", which would otherwise hit
// the 'template' track row and render the not-yet-ported placeholder.

const IMG = '/assets/images';

const services = [
  { icon: 'rwd-icon.svg', title: 'Responsive<br> Web Design', href: '/web-design-agency-chicago', copy: 'Modern web design services for your business. We use the latest technology guaranteed to look great on any device.' },
  { icon: 'seo-icon.svg', title: 'Search Engine<br> Optimization', href: '/seo-agency-chicago', copy: 'We use proven search engine optimization (SEO) strategies to promote your business and drive traffic to your website.' },
  { icon: 'wd-icon.svg', title: 'Web<br> Development', href: '/web-development-agency-chicago', copy: 'We’ve helped over 600 clients set up blogs, e-commerce, and responsive websites that are easy to update.' },
  { icon: 'ppc-icon.svg', title: 'PPC<br> Services', href: '/ppc-agency-chicago', copy: 'Alpha Efficiency is miles ahead of the competition thanks to our specialized team of PPC account managers.' },
  { icon: 'wp-icon.svg', title: 'Wordpress<br> Maintenance', href: '/wordpress-maintenance-chicago', copy: 'Modern web design services for your business. We use the latest technology guaranteed to look great on any device.' },
  { icon: 'others-icon.svg', title: 'Other<br> Services', href: '/other-services', copy: 'Modern web design services for your business. We use the latest technology guaranteed to look great on any device.' },
];

const portfolio = [
  { name: 'Purple Care', kind: 'UX & Web Design', url: 'https://www.purplecare.com', img: 'purplecare.webp', extra: 'purplecareNew' },
  { name: 'Breachlock', kind: 'Branding, UX & Web Design', url: 'https://www.breachlock.com', img: 'breachlock.webp', extra: '' },
  { name: 'School Choice Week', kind: 'UX & Web Design', url: 'https://schoolchoiceweek.com', img: 'school.webp', extra: '' },
];

const featuredOn = [
  { file: 'lifehacker.svg', alt: 'Lifehacker', w: 179, h: 49 },
  { file: 'cloudways.svg', alt: 'Cloudways', w: 175, h: 156 },
  { file: 'hubspot.svg', alt: 'HubSpot', w: 184, h: 159 },
  { file: 'clutch.svg', alt: 'Clutch', w: 161, h: 166 },
];

const testimonials = [
  { img: 'DavidPinyerd.svg', logo: 'PinyerdLawLogo.svg', name: 'David Pinyerd', position: 'Founder, Attorney', quote: '“Our revenue has gone up 70% in 6 months, our number of cases has gone up even more than that. He\'s very transparent, there\'s no BS, no excuses, just getting the job done and getting us ranked very high”' },
  { img: 'justinberg.webp', logo: 'purplecare-logo.svg', name: 'Justin Berg', position: 'President, CEO', quote: '“They were transparent, backed everything with real data, and never hid anything. Most importantly, they made a promise and delivered. As a business owner, that clarity and trust make it possible to confidently grow your company.”' },
  { img: 'tangram.webp', logo: 'tangram.svg', name: 'Milind M. Lele', position: 'President, CEO', quote: '“Brian and the team managed to hone in precisely on our target audience and connect us with the qualified prospects within our specialized niche. These efforts created meaningful demos and results.”' },
  { img: 'jen-duncan.webp', logo: 'brio.svg', name: 'Jen Duncan', position: 'President, CEO', quote: '“One thing I like about them is that they’re very easy to reach. I can contact the owner, Brian (Director of Strategic Planning), at any time. Their turnaround time has always been what they said it would be.”' },
  { img: 'surve-photo.webp', logo: 'surve.svg', name: 'Darrell Terry', position: 'President, CEO', quote: '“Alpha Efficiency designed our website and other platforms to establish our foundation. As we grow, their work will continue to impact by providing their development, marketing, and consulting services; Alpha brings a lot to my company”' },
  { img: 'aeriform-photo.webp', logo: 'aeriform.svg', name: 'Nicolas Silva', position: 'President, CEO', quote: '“I always wanted to have the highest quality image, but that’s not sustainable when building a website. When Brian’s team redesigned our site, I realized how much faster it could be if it’s properly built out.”' },
];

const clientLogos = [
  'aeriform.svg', 'ignite.svg', 'jpar.svg', 'tangram.svg', 'joorney.svg', 'smith.svg',
  'incomewiz.svg', 'breachlock.svg', 'cih.svg', 'better-weigh.svg', 'reveal.svg', 'sverdloff.svg'
];

const faqs = [
  { q: 'How much does it cost to hire a web designer to build a website?', a: 'We offer transparent pricing. You can expect to pay $4,000+ for a new website. Projects with e-commerce functionality or SEO services cost more.<br><br>Check out our detailed article regarding pricing, or get a free website quote in a few minutes.' },
  { q: 'How much should I expect to pay for website maintenance and support?', a: 'Our turn-key website maintenance and management services start at $200/month. Please find out more by visiting our website maintenance page.<br><br>We offer flexible monthly payment plans.' },
  { q: 'Do you develop and maintain WordPress websites?', a: 'We love the WordPress platform for building websites and think it’s the best for SEO. It’s our platform of choice and we specialize in it.<br><br>Read about our detailed WordPress maintenance plans on this page. Clio Websites is a premier WordPress development agency.' },
  { q: 'Do you use templates to develop websites?', a: 'We don’t use website design templates to develop sites. All of our projects are unique and custom-developed for each client.<br><br>Your business is unique, and your website should be unique as well. While there is nothing wrong with templated websites (as lots of web designers use them), custom-developed websites perform better and more appropriately represent your business and your brand.' },
  { q: 'Do you offer digital marketing services?', a: 'We are a premier digital marketing agency. We have helped many clients reach the first page of Google with our proven marketing strategies. To find out more, check out our detailed SEO page.' },
];

const strategyCards = [
  { icon: 'chat-icon.svg', heading: 'From traffic leaks to consistent <strong>inbound leads</strong>.', embed: 'LR4GkyBuq2g', thumb: 'purplecare-video.webp', thumbAlt: 'Turning SEO into Consistent Leads for Purple Care', quote: '“You made a promise, and you delivered. <br><strong>No excuses, no extra charges.</strong>”' },
  { icon: 'user-icon.svg', heading: 'Turning traffic into <strong>qualified sales</strong> calls.', embed: 'QNQcbWCN0MY', thumb: 'pinyerdlaw-video.webp', thumbAlt: 'How We Increased Pinyerd Law Revenue by 70%', quote: '“Very transparent, no disconnect, and our numbers <strong>have all gone up</strong>.”' },
  { icon: 'bulb-icon.svg', heading: 'How clarity &amp; conversion led to <strong>growth</strong>.', embed: 'G0X6JGXAhBU', thumb: 'krissia-video.webp', thumbAlt: 'Client Spotlight: Krissia shares her journey with Alpha Efficiency', quote: '“We’re extremely satisfied. The traffic keeps <strong>growing better and better</strong>.”' },
];
---

<Base
  title="Alpha Efficiency.™ – Website Design, SEO & AI Development Agency"
  description="Website design, SEO and AI development agency in Chicago. We build sites that make your phone ring. 600+ businesses trust us."
  path="/"
  image={`${IMG}/home/david.webp`}
  type="website"
  fullBleed={true}
  bodyClass="home page-template page-template-template-home template-home page front-page"
>
  <!-- ─────────────────────────────── hero ─────────────────────────────── -->
  <section class="home-one" id="make">
    <div class="content-holder">
      <img
        src={`${IMG}/home/statue-left.webp`} width="450" height="787" alt="Left statue"
        class="statue-desktop statue-left statue-hero" loading="eager" decoding="async"
        style="margin-left: 2%; object-fit: contain; max-width: 450px; width: 24%;"
      />

      <div class="text">
        <div class="titles">
          <h1 class="subtitle">Website Design, SEO &amp; AI Development Agency.</h1>
          <h2>Stop losing profit to a dead website.<br />Our sites <span>make your phone ring.</span></h2>
        </div>

        <a href="#contact" class="call-btn call-btn-red">
          <div class="svg-frame">
            <svg width="52" height="31" viewBox="0 0 52 31" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M29.1113 26.8955L19.1176 24.173C12.706 22.4157 5.86492 23.1808 0 26.3111L0.624193 27.4799C6.19054 24.5119 12.6818 23.7872 18.7656 25.4545L28.7594 28.1771C31.6202 28.9588 34.5723 29.3562 37.5379 29.3591C39.5288 29.3561 41.5154 29.1761 43.4744 28.8212V27.4931C38.703 28.3812 33.7924 28.1769 29.1113 26.8955Z" fill="#FFB000"></path> <path d="M42.8085 30.6892C44.2754 30.6892 45.4646 29.5 45.4646 28.0331C45.4646 26.5661 44.2754 25.377 42.8085 25.377C41.3415 25.377 40.1523 26.5661 40.1523 28.0331C40.1523 29.5 41.3415 30.6892 42.8085 30.6892Z" fill="white"></path> <path d="M51.0863 19.7124C44.2093 22.9068 36.4251 23.57 29.1067 21.585L19.113 18.8625C16.8834 18.2567 14.5839 17.9464 12.2734 17.9395C12.3566 18.3782 12.3566 18.8287 12.2734 19.2675C14.4763 19.2697 16.6691 19.5644 18.7943 20.1441L28.788 22.8666C31.6381 23.6453 34.5788 24.0428 37.5333 24.0486C42.4104 24.0495 47.2286 22.9843 51.6507 20.9276L51.0863 19.7124Z" fill="#FFB000"></path> <path fill-rule="evenodd" clip-rule="evenodd" d="M9.14239 15.4103C8.32188 15.2935 7.48768 15.5057 6.82403 16.0021C6.33069 16.374 5.95917 16.8849 5.75469 17.4679C5.55025 18.0509 5.52262 18.6818 5.67559 19.2804C5.82863 19.8787 6.1551 20.4188 6.61407 20.8321C7.07314 21.2454 7.64743 21.514 8.2586 21.6036C8.40728 21.6261 8.55745 21.6365 8.70782 21.6368C9.42074 21.6361 10.1118 21.3914 10.6648 20.9415C11.2178 20.4916 11.6002 19.862 11.7459 19.1642C11.8268 18.7889 11.8362 18.4014 11.7742 18.0226L11.7723 18.0118C11.701 17.5098 11.5048 17.0319 11.202 16.6251C10.7033 15.964 9.96235 15.5271 9.14239 15.4103ZM9.40899 16.4923C9.01104 16.3533 8.58084 16.3353 8.17266 16.4405C7.76438 16.5458 7.39615 16.7698 7.11504 17.0841C6.83404 17.3983 6.6519 17.7888 6.59258 18.2062C6.5333 18.6236 6.59961 19.0497 6.78204 19.4298C6.96445 19.8097 7.25541 20.1271 7.61797 20.3419C7.98067 20.5567 8.39923 20.6595 8.82012 20.6368C9.24119 20.614 9.64663 20.4667 9.98418 20.214C10.2014 20.0487 10.3858 19.8387 10.5193 19.6007C10.6727 19.3499 10.7719 19.0699 10.8113 18.7784C10.8416 18.5538 10.8363 18.3255 10.7947 18.1036L10.741 17.8839C10.6712 17.6454 10.5584 17.4214 10.409 17.2228C10.1552 16.8862 9.80694 16.6314 9.40899 16.4923Z" fill="white"></path> <path d="M43.6147 20.3847C42.9943 20.4922 42.3717 20.5827 41.7467 20.654V12.1335L43.6147 10.8794V20.3847Z" fill="white"></path> <path fill-rule="evenodd" clip-rule="evenodd" d="M39.7822 0C41.951 0 43.6187 1.57689 43.6187 3.40456V6.36704L27.8602 16.9293C27.2619 17.3292 26.5704 17.565 25.8561 17.6153L25.5481 17.6255H25.5441C24.7213 17.6291 23.9149 17.3864 23.231 16.9293L7.45312 6.36602V3.40456C7.45312 1.57686 9.12004 0.000130758 11.2886 0H39.7822ZM11.3089 1.55594C10.8112 1.53997 10.3254 1.71784 9.95624 2.05493C9.58143 2.39722 9.35894 2.87452 9.33529 3.38017L9.33427 3.39237V5.60686L24.3855 15.722L24.3926 15.726C24.735 15.949 25.1356 16.0695 25.5461 16.0695C25.9563 16.0694 26.3571 15.949 26.6996 15.726L26.7067 15.722L41.7508 5.60686V3.3822C41.7402 3.13224 41.6799 2.88545 41.5739 2.65759C41.468 2.42988 41.3181 2.22603 41.1339 2.05697C40.9491 1.88746 40.7322 1.75559 40.4967 1.66976C40.3214 1.60594 40.1363 1.56726 39.9479 1.55695L39.9337 1.55594H11.3089Z" fill="white"></path> <path d="M9.33427 12.1335L9.32086 14.4034C8.98687 14.3541 8.64728 14.3448 8.30966 14.378C8.02047 14.4064 7.73556 14.4653 7.46004 14.5528L7.47345 10.8814L9.33427 12.1335Z" fill="white"></path> </svg>
          </div>
          <p>Build A Winning Site</p>
        </a>

        <img src={`${IMG}/home/Partners.svg`} alt="Partners" class="banner-svg" loading="eager" decoding="async" />

        <div class="pf-trust-left">
          <h3>600+</h3>
          <p>Businesses Trust Us</p>
        </div>
      </div>

      <img src={`${IMG}/home/david-mobile.webp`} alt="Right statue" class="statue-mobile statue-right"
        fetchpriority="high" loading="eager" decoding="async" width="275" height="338" />

      <img src={`${IMG}/home/david.webp`} alt="Right statue" class="statue-desktop statue-right statue-hero"
        loading="eager" decoding="async" width="650" height="800" />
    </div>
  </section>

  <!-- ────────────────────────────── second ────────────────────────────── -->
  <section class="second" id="grow">
    <div class="second-container">
      <div class="second-box upper">
        <div class="video-container">
          <img class="buttonPlay video-image" src={`${IMG}/alpha-new-home/video.webp`} alt="Alpha Efficiency Promo Video" loading="lazy" />
        </div>
        <div class="second-text">
          <h2>Web Design With<br /> <span>SEO First Approach</span></h2>
          <div class="line"></div>
          <p>We lead with web development services that enable excellent rankings &amp; conversions to gain a profitable advantage for our business partners.</p>
          <div class="section-circle-button">
            <a href="/schedule-a-call">Grow Your Business <span></span></a>
          </div>
        </div>
      </div>

      <div class="decor">
        <svg width="1320" height="71" viewBox="0 0 1322 34" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M663.568 23.234C663.568 23.234 657.72 32.7458 653.314 30.9873C648.909 29.2288 653.749 20.4964 653.749 20.4964C653.749 20.4964 656.1 15.7605 659.676 15.6806C663.252 15.6006 663.568 23.234 663.568 23.234Z" fill="#2C73DB"/>
          <path d="M647.309 24.5734L642.251 33.4258H652.09C652.09 33.4058 645.807 31.967 647.309 24.5734Z" fill="#ED462F"/>
          <path d="M657.324 33.4254C657.324 33.4254 662.737 31.8468 665.424 28.11C665.424 28.11 665.72 32.5062 669.79 33.4054L657.324 33.4254Z" fill="#ED462F"/>
          <path d="M671.234 18.5988L679.749 33.3261L671.807 33.406C671.807 33.406 673.447 33.0264 674.79 31.4677C674.79 31.4677 674.929 31.2679 674.573 31.3478C674.217 31.4277 670.681 32.1071 669.496 28.4903L668.014 23.8943L671.234 18.5988Z" fill="#ED462F"/>
          <path d="M666.394 18.2789C666.394 18.2789 664.992 13.503 660.092 13.503C654.935 13.503 651.537 17.3996 651.537 17.3996L661.04 0.574219L668.706 14.3023L666.394 18.2789Z" fill="#2C73DB"/>
          <path d="M1 21.7899L1321 21.79" stroke="url(#hp_line)" stroke-linecap="round"/>
          <defs>
            <linearGradient id="hp_line" x1="1" y1="22.7899" x2="1321" y2="22.79" gradientUnits="userSpaceOnUse">
              <stop stop-color="#1994FF" stop-opacity="0.5"/>
              <stop offset="0.440197" stop-color="#1994FF" stop-opacity="0"/>
              <stop offset="0.56176" stop-color="#1994FF" stop-opacity="0"/>
              <stop offset="1" stop-color="#1994FF" stop-opacity="0.5"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <div class="second-box lower">
        <div class="second-text">
          <h2><span>600 Websites</span> <br /> And Counting...</h2>
          <div class="line"></div>
          <p>We help forward-thinking companies perfect their online presence by empowering their web design and their search performance, communication, and software environment.</p>
          <div class="section-circle-button">
            <a href="/schedule-a-call">Get Inspired <span></span></a>
          </div>
        </div>
        <div class="img-frame">
          <img src={`${IMG}/home/brian2.webp`} width="637" height="358" alt="Mission" class="img-fluid" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ────────────────────────────── third ─────────────────────────────── -->
  <section class="third" id="intelligence">
    <div class="container-fluid">
      <div class="intelligence">
        <h2>Analytics &amp; Data Driven <br /> <span>Web Design Company</span></h2>
        <div class="line"></div>
        <p>Alpha Efficiency engages in research &amp; development of high-leverage design &amp; front-end code for business purposes. We serve as an independent resource of analysis, code, and business intelligence to ensure that our business partners get the best possible data and user experience to ensure sustainable growth.</p>
        <div class="section-circle-button">
          <a href="/about">About Us <span></span></a>
        </div>
      </div>
      <div class="featured-on">
        <div class="featured-box">
          <div class="featured-header"><p>Featured On</p></div>
          <div class="frame">
            <div class="frame">
              {featuredOn.map((f) => (
                <p>
                  <img src={`${IMG}/home/third-section-icons/analytics/${f.file}`} width={f.w} height={f.h} alt={f.alt} class="img-fluid" loading="lazy" />
                </p>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────────── services ───────────────────────────── -->
  <section class="homepage-services">
    <div class="container-fluid">
      <div class="titles">
        <h2>Services</h2>
        <h3><strong>Web Design</strong> Services</h3>
        <svg width="60" height="1" viewBox="0 0 60 1" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="60" height="1" fill="#898989"/></svg>
      </div>

      <!-- The six cards are wider than the container, so they scroll. The
           track is a separate element from .cards-container because the arrows
           are absolutely positioned against the container and must not scroll
           away with the cards. -->
      <div class="cards-container">
        <button class="arrow left" aria-label="Previous services" data-services-prev>
          <svg xmlns="http://www.w3.org/2000/svg" width="12" height="20" viewBox="0 0 12 20" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.82843 9.70711L11.1213 1.41421L9.70711 0L0 9.70711L9.70711 19.4142L11.1213 18L2.82843 9.70711Z" fill="#1994FF"/></svg>
        </button>

        <div class="cards-track" data-services-track>
          {services.map((s) => (
            <div class="service-card">
              <img src={`${IMG}/home/services/${s.icon}`} alt="" class="service-icon" loading="lazy" />
              <h4 set:html={s.title} />
              <p>{s.copy}</p>
              <a href={s.href} class="card-link">VIEW DETAILS</a>
            </div>
          ))}
        </div>

        <button class="arrow right" aria-label="Next services" data-services-next>
          <svg xmlns="http://www.w3.org/2000/svg" width="12" height="20" viewBox="0 0 12 20" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.82843 9.70711L11.1213 1.41421L9.70711 0L0 9.70711L9.70711 19.4142L11.1213 18L2.82843 9.70711Z" fill="#1994FF"/></svg>
        </button>
      </div>

      <a href="/schedule-a-call" class="schedule-a-call-btn">
        Schedule a Call
        <img src={`${IMG}/home/services/call-icon.svg`} alt="" />
      </a>
    </div>
  </section>

  <!-- ──────────────────────────── portfolio ───────────────────────────── -->
  <section class="homepage-our-portfolio">
    <div class="container-fluid">
      <div class="titles">
        <h2><strong>Our</strong> Portfolio</h2>
        <svg width="88" height="1" viewBox="0 0 88 1" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="88" height="1" fill="#898989"/></svg>
        <p>We craft unique digital experiences. Our projects are responsive, lightning-fast, and custom tailored to your brand.</p>
      </div>

      <div class="cards-container">
        {portfolio.map((p) => (
          <div class={`portfolio-cardNew ${p.extra}`.trim()}>
            <div class="titles">
              <h3>{p.name}</h3>
              <h4>{p.kind}</h4>
            </div>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="card-link">VIEW LIVE</a>
            <img src={`${IMG}/home/portfolio/${p.img}`} alt={p.name} class="portfolio-image" loading="lazy" />
          </div>
        ))}
      </div>

      <div class="section-circle-button">
        <a href="/portfolio" style="text-decoration: none">See Our Portfolio<span></span></a>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── testimonials ─────────────────────────── -->
  <section class="fifth" id="clients">
    <div class="container-fluid">
      <div class="header">
        <h2><span>What Our Clients</span> Are Saying</h2>
        <div class="line"></div>
      </div>

      <div id="fadeCarousel" class="carousel slide quotes carousel-fade">
        <div class="carousel-inner">
          {testimonials.map((t, i) => (
            <div class={`carousel-item ${i === 0 ? 'active' : ''}`.trim()}>
              <div class="info-wrap">
                <div class="img-wrap">
                  <img loading="lazy" src={`${IMG}/home/testimonials/${t.img}`} width="270" height="270" alt={t.name} class="img-fluid" />
                </div>
                <div class="client-logo">
                  <img src={`${IMG}/home/testimonials/${t.logo}`} width="150" alt={`${t.name} company logo`} class="img-fluid" loading="lazy" />
                </div>
              </div>
              <p class="quote-text">
                <img src={`${IMG}/home/quote-reviews.svg`} alt="Quote" />
                {t.quote}
              </p>
              <div class="thirth-col">
                <div class="controls-desktop">
                  <button class="carousel-control-prev" data-slide="prev" aria-label="Previous testimonial">
                    <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="64" height="64" rx="32" fill="#E8F5FF"/><path fill-rule="evenodd" clip-rule="evenodd" d="M28.8284 31.7071L37.1213 23.4142L35.7071 22L26 31.7071L35.7071 41.4142L37.1213 40L28.8284 31.7071Z" fill="#1994FF"/></svg>
                  </button>
                  <button class="carousel-control-next" data-slide="next" aria-label="Next testimonial">
                    <svg width="65" height="64" viewBox="0 0 65 64" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="64" height="64" rx="32" fill="#E8F5FF"/><path fill-rule="evenodd" clip-rule="evenodd" d="M34.7929 31.7071L26.5 40L27.9142 41.4142L37.6213 31.7071L27.9142 22L26.5 23.4142L34.7929 31.7071Z" fill="#1994FF"/></svg>
                  </button>
                </div>
                <div class="client-name">
                  <p class="name-quote">{t.name}</p>
                  <p class="function-quote mb-4">{t.position}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
