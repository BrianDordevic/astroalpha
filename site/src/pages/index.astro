  <style is:global>
    /* The theme markup used <a role="button"> for the carousel arrows, so its
       stylesheet never resets button chrome. Porting them to real <button>
       elements — correct, since they are controls rather than links — meant the
       browser's default background, 2px outset border and padding rendered as
       grey squares around the circular SVGs.

       Bootstrap also fades .carousel-control-* to opacity .5, which reads as
       disabled. That is inherited from production, but these are the only way
       to move the carousel, so they are shown at full strength here. The
       theme's own hover (blue fill, white chevron) still applies. */
    .fifth .carousel-control-prev,
    .fifth .carousel-control-next {
      appearance: none;
      -webkit-appearance: none;
      background: none;
      border: 0;
      padding: 0;
      margin: 0;
      opacity: 1;
      line-height: 0;
      cursor: pointer;
    }

    .fifth .carousel-control-prev svg,
    .fifth .carousel-control-next svg {
      display: block;
      transition: transform 0.2s ease;
    }

    .fifth .carousel-control-prev:hover svg,
    .fifth .carousel-control-next:hover svg {
      transform: scale(1.06);
    }

    /* Keyboard users need a visible target; the default ring is clipped by the
       circular artwork, so draw it on the button instead. */
    .fifth .carousel-control-prev:focus-visible,
    .fifth .carousel-control-next:focus-visible {
      outline: 2px solid #1994ff;
      outline-offset: 3px;
      border-radius: 50%;
    }

    /* ── Services carousel ────────────────────────────────────────────────
       Six 276px cards plus gaps come to ~1816px inside a 1176px container, so
       the theme let them spill past the container on both sides — cards were
       sliced by the viewport edge rather than aligned to the site grid. The
       track now clips at the container and scrolls, so the row starts and ends
       on the grid and the arrows reveal the rest. */
    .homepage-services .cards-track {
      display: flex;
      gap: 32px;
      overflow-x: auto;
      /* No `scroll-behavior: smooth` here on purpose. Combined with mandatory
         snapping it fought the programmatic scroll and snapped straight back to
         0, so the arrows appeared dead. The JS passes behavior:'smooth' per
         call, which snapping cooperates with. Proximity rather than mandatory
         for the same reason — it tidies the resting position without
         overriding where the scroll was asked to go. */
      scroll-snap-type: x proximity;
      /* Room for the cards' own drop shadows, which clip otherwise. */
      padding: 12px 4px 24px;
      scrollbar-width: none;
    }
    .homepage-services .cards-track::-webkit-scrollbar { display: none; }

    .homepage-services .cards-track > .service-card {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }

    /* The arrows sit outside the scrolling track so they stay put. */
    .homepage-services .cards-container > .arrow {
      z-index: 2;
    }
    .homepage-services .cards-container > .arrow[hidden] {
      visibility: hidden;
    }

    /* ── Portfolio row ───────────────────────────────────────────────────
       The cards are squares sized by a fixed `height: 424px` with
       `aspect-ratio: 1/1`, so three of them plus two 24px gaps need 1320px in a
       1176px container — the third wrapped onto its own line, which is what
       made the section look cramped.

       Letting them share the row (376px each here) and dropping the fixed
       height lets the aspect ratio set it, so they stay square and land on one
       baseline. Selectors match the theme's own specificity, which is why they
       are this long. */
    .page-template-template-home section.homepage-our-portfolio .container-fluid .cards-container {
      flex-wrap: nowrap;
      align-items: stretch;
    }
    .page-template-template-home section.homepage-our-portfolio .container-fluid .cards-container .portfolio-cardNew {
      flex: 1 1 0;
      min-width: 0;
      height: auto;
    }

    /* Below the point where three squares stop being readable, go back to
       wrapping rather than shrinking them further. */
    @media (max-width: 900px) {
      .page-template-template-home section.homepage-our-portfolio .container-fluid .cards-container {
        flex-wrap: wrap;
      }
      .page-template-template-home section.homepage-our-portfolio .container-fluid .cards-container .portfolio-cardNew {
        flex: 1 1 320px;
        max-width: 424px;
      }
    }
  </style>

