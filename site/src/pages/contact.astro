---
import Base from '../layouts/Base.astro';
import ProjectForm from '../components/ProjectForm.astro';

// Ported from alpha-efficiency-2024 template-contact_us.blade.php ->
// partials.contact_us.contact_section.
//
// bodyClass carries `template-contact_us` because pages/_contact-us.scss is
// scoped under it. Note the underscore — it mirrors the Blade filename, not
// the stylesheet's hyphenated name, and getting it wrong renders the page
// unstyled with no other symptom.

// Schema.org graph carried across from the Blade template so the contact
// point and page identity survive the migration.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': 'https://alphaefficiency.com/contact#webpage',
      url: 'https://alphaefficiency.com/contact',
      name: 'Contact Alpha Efficiency',
      description:
        'Get in touch with Alpha Efficiency. Contact our Chicago-based web design and digital marketing agency for consultations and project inquiries.',
      isPartOf: { '@id': 'https://alphaefficiency.com/#website' },
      about: { '@id': 'https://alphaefficiency.com/#organization' },
    },
    {
      '@type': 'ContactPoint',
      '@id': 'https://alphaefficiency.com/contact#contact',
      contactType: 'customer support',
      telephone: '+13123006746',
      availableLanguage: ['English'],
      areaServed: 'Chicago, IL & Worldwide',
      provider: { '@id': 'https://alphaefficiency.com/#organization' },
    },
  ],
};
---

